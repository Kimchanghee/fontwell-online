---
import { readFile } from 'fs/promises';
import { join } from 'path';
import AffiliateBanner from '../components/AffiliateBanner.astro';

const amazonPicks = [
  { searchQuery: 'typography graphic design book', title: 'Typography & Design Book', subtitle: '디자인·타이포그래피 입문서', emoji: '📕' },
  { searchQuery: 'wacom one drawing tablet', title: 'Wacom Drawing Tablet', subtitle: '디자이너용 펜 태블릿', emoji: '🖋️' },
  { searchQuery: 'monitor color calibration spyder', title: 'Color Calibration Spyder', subtitle: '모니터 컬러 캘리브레이션', emoji: '🎨' }
];

interface FontMeta {
  family: string;
  category: string;
  variants: string[];
  subsets: string[];
  source: 'google' | 'noonnu';
  designer?: string;
  license: string;
  previewUrl: string;
}

let fonts: FontMeta[] = [];
try {
  const data = await readFile(join(process.cwd(), 'src/data/fonts.json'), 'utf-8');
  fonts = JSON.parse(data);
} catch {}

const koreanFonts = fonts.filter((f) => f.subsets.includes('korean'));
const popular = fonts.filter((f) => f.source === 'google').slice(0, 24);

const safeAdKey = import.meta.env.PUBLIC_ADSTERRA_BANNER_KEY || import.meta.env.PUBLIC_ADSTERRA_POPUNDER_KEY || '';
const safeAdSrcDoc = safeAdKey ? `<!doctype html><html><head><meta charset="utf-8" /><style>html,body{margin:0;padding:0;overflow:hidden;background:transparent}body{display:grid;place-items:center;min-height:250px}</style></head><body><script type="text/javascript">atOptions={'key':'${safeAdKey}','format':'iframe','height':250,'width':300,'params':{}};<\/script><script type="text/javascript" src="https://www.highperformanceformat.com/${safeAdKey}/invoke.js"><\/script></body></html>` : '';

const baseUrl = import.meta.env.PUBLIC_SITE_URL || 'https://fontwell.online';
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Google Analytics 4 -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-G0YE8ZCN66"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-G0YE8ZCN66', { page_path: window.location.pathname });
    </script>
    <title>FontWell — 무료 폰트·아이콘·템플릿 검색</title>
    <meta name="description" content="Google Fonts 1700+, 한글 무료폰트, Iconify, 무료 템플릿을 한 곳에서 검색하고 미리보기. 라이선스·다운로드·미리보기 통합." />
    <link rel="canonical" href={baseUrl} />
    <link rel="alternate" hreflang="ko" href={baseUrl} />
    <link rel="alternate" hreflang="x-default" href={baseUrl} />
    <link rel="stylesheet" href="/global.css" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="FontWell — 무료 폰트·아이콘·템플릿 검색" />
    <meta property="og:description" content="Google Fonts 1700+, 한글 무료폰트, Iconify, 무료 템플릿 통합 검색" />
    <meta property="og:url" content={baseUrl} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:site_name" content="FontWell" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="FontWell — 무료 폰트·아이콘·템플릿 검색" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        { "@type": "Organization", "@id": `${baseUrl}#org`, "name": "FontWell", "url": baseUrl },
        { "@type": "WebSite", "@id": `${baseUrl}#site`, "url": baseUrl, "name": "FontWell", "inLanguage": "ko-KR", "publisher": { "@id": `${baseUrl}#org` }, "potentialAction": { "@type": "SearchAction", "target": `${baseUrl}/?q={search_term_string}`, "query-input": "required name=search_term_string" } },
        { "@type": "WebApplication", "name": "FontWell", "applicationCategory": "DesignApplication", "operatingSystem": "Any", "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" } },
        { "@type": "FAQPage", "mainEntity": [
          { "@type": "Question", "name": "FontWell은 무엇인가요?", "acceptedAnswer": { "@type": "Answer", "text": "Google Fonts 1700+, 한글 무료폰트(눈누), 무료 아이콘, 디자인 템플릿을 한 곳에서 검색·미리보기·다운로드할 수 있는 무료 디자이너 위키입니다." } },
          { "@type": "Question", "name": "한글 무료폰트 라이선스는 어떻게 확인하나요?", "acceptedAnswer": { "@type": "Answer", "text": "각 폰트 상세 페이지에서 OFL/MIT/Apache 등 정확한 라이선스를 표시합니다. 상업적 이용 가능 여부도 함께 확인할 수 있습니다." } },
          { "@type": "Question", "name": "회원가입이 필요한가요?", "acceptedAnswer": { "@type": "Answer", "text": "아니요. 회원가입 없이 모든 폰트와 템플릿을 검색·미리보기·다운로드할 수 있습니다." } }
        ]}
      ]
    })} />
    <script is:inline>
  window.addEventListener('click', function(event) {
    var link = event.target && event.target.closest ? event.target.closest('a[rel*="sponsored"], [data-affiliate-link]') : null;
    if (!link || typeof window.gtag !== 'function') return;
    window.gtag('event', 'affiliate_click', {
      merchant: (link.textContent || '').trim().slice(0, 60) || 'partner',
      placement: link.getAttribute('data-placement') || link.getAttribute('aria-label') || 'sponsored-link',
      page_location: window.location.href
    });
  }, { capture: true });
</script>
</head>
  <body class="bg-slate-50 text-slate-900 antialiased">
    <header class="border-b bg-white">
      <div class="container mx-auto flex max-w-6xl items-center justify-between p-4">
        <a href="/" class="text-2xl font-bold text-purple-600">FontWell</a>
        <nav class="flex gap-3 text-sm">
          <a href="/category/sans-serif" class="hover:text-purple-600">Sans</a>
          <a href="/category/serif" class="hover:text-purple-600">Serif</a>
          <a href="/category/display" class="hover:text-purple-600">Display</a>
          <a href="/category/korean" class="hover:text-purple-600">한글</a>
        </nav>
      </div>
    </header>

    <section class="bg-gradient-to-br from-purple-50 to-white py-12">
      <div class="container mx-auto max-w-6xl px-4 text-center">
        <h1 class="text-4xl md:text-5xl font-bold tracking-tight">디자이너의 폰트·템플릿 위키</h1>
        <p class="mt-3 text-slate-600">{fonts.length}개 폰트 + 한글 무료폰트 + 무료 아이콘 + 템플릿. 모두 무료.</p>
      </div>
    </section>

    {koreanFonts.length > 0 && (
      <section class="container mx-auto max-w-6xl px-4 py-8">
        <h2 class="mb-4 text-2xl font-semibold">한글 무료폰트</h2>
        <div class="grid grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-3">
          {koreanFonts.slice(0, 9).map((f) => (
            <a
              href={`/font/${encodeURIComponent(f.family.toLowerCase().replace(/\s+/g, '-'))}`}
              class="rounded-xl border bg-white p-5 transition hover:border-purple-400 hover:shadow"
            >
              <h3 class="text-lg font-semibold">{f.family}</h3>
              {f.designer && <p class="text-xs text-slate-500">{f.designer}</p>}
              <p class="mt-2 text-sm text-slate-600">한글 다양성을 즐기는 가장 빠른 길</p>
              <p class="mt-2 text-xs text-purple-600">{f.license}</p>
            </a>
          ))}
        </div>
      </section>
    )}

    {popular.length > 0 && (
      <section class="container mx-auto max-w-6xl px-4 py-8">
        <h2 class="mb-4 text-2xl font-semibold">인기 영문 폰트</h2>
        <div class="grid grid-cols-2 gap-3 md:grid-cols-4">
          {popular.map((f) => (
            <a
              href={`/font/${encodeURIComponent(f.family.toLowerCase().replace(/\s+/g, '-'))}`}
              class="rounded-lg border bg-white p-3 hover:border-purple-400"
            >
              <span class="font-semibold">{f.family}</span>
              <span class="ml-2 text-xs capitalize text-slate-500">{f.category}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <div class="container mx-auto max-w-6xl px-4">
      <AffiliateBanner
        amazonPicks={amazonPicks}
        coupangKeyword="디자인 책 타이포그래피"
        amazonKeyword="typography design book"
        aliexpressCategory="graphic-tablet"
      />
    </div>

    {safeAdSrcDoc && (
      <section class="container mx-auto max-w-6xl px-4 py-6">
        <aside class="safe-inline-adsterra rounded-xl border bg-white p-4" aria-label="Advertisement">
          <p class="mb-2 text-[11px] font-semibold uppercase text-slate-500">Advertisement</p>
          <div class="grid place-items-center overflow-hidden">
            <iframe title="safe-inline-adsterra" width="300" height="250" loading="eager" srcdoc={safeAdSrcDoc} class="border-0"></iframe>
          </div>
        </aside>
      </section>
    )}

  </body>
</html>
