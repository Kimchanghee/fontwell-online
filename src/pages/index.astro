---
import Base from '../layouts/Base.astro';
import FontRow from '../components/FontRow.astro';
import { families, stats, fontsData, asOfHuman, fmtInt, CATEGORIES } from '../lib/data';
import { fitTitle, fitDesc, abs } from '../lib/seo';
import { site } from '../site.config';

const st = stats();
const matched = st.total - st.lic.none;
const INITIAL = 48;
const title = fitTitle(['Free fonts for commercial use, licence-checked | Fontwell', 'Free commercial-use fonts, licence-checked | Fontwell']);
const description = fitDesc([
  `Search ${fmtInt(st.total)} Google Fonts families by script, weight and variable axes, with a plain-English verdict on commercial, logo, app and web use for each licence.`,
  `Search ${fmtInt(st.total)} Google Fonts families by script, weights and variable axes, with a plain-English verdict on commercial, logo and web use for each licence.`,
]);
const SCRIPTS = [
  ['latin', 'Latin'], ['latin-ext', 'Latin extended'], ['cyrillic', 'Cyrillic'], ['greek', 'Greek'], ['vietnamese', 'Vietnamese'],
  ['korean', 'Korean'], ['japanese', 'Japanese'], ['chinese-simplified', 'Chinese (Simplified)'], ['chinese-traditional', 'Chinese (Traditional)'],
  ['arabic', 'Arabic'], ['hebrew', 'Hebrew'], ['devanagari', 'Devanagari'], ['thai', 'Thai'], ['bengali', 'Bengali'], ['tamil', 'Tamil'],
];
const catRows = CATEGORIES.map((c) => {
  const fs = families.filter((f) => f.c === c);
  return { c, n: fs.length, ofl: fs.filter((f) => f.lic === 'ofl').length, apache: fs.filter((f) => f.lic === 'apache').length, ufl: fs.filter((f) => f.lic === 'ufl').length, vf: fs.filter((f) => f.ax.length).length };
});
const ld = [{
  '@type': 'Dataset',
  name: 'Licence and coverage index of the Google Fonts library',
  description: `Family-level index of ${st.total} Google Fonts families with category, subsets, weights, variable axes and the licence folder each family sits in within the google/fonts repository.`,
  url: abs('/'),
  creator: { '@id': `${site.url}/#organization` },
  dateModified: fontsData.asOf,
  temporalCoverage: `../${fontsData.asOf.slice(0, 10)}`,
  isBasedOn: [fontsData.sourceUrl, fontsData.licenseSourceUrl],
  license: 'https://creativecommons.org/licenses/by/4.0/',
  distribution: { '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: abs('/data/fonts-index.json') },
}];
---
<Base title={title} description={description} path="/" og="/og/home.png" ld={ld} wide>
  <section class="desk-head">
    <p class="kicker">Proofing desk · {fmtInt(st.total)} families · {asOfHuman}</p>
    <h1>Which free fonts can you use commercially?</h1>
    <p class="lede" data-answer>
      <strong>Practically all of them.</strong> Of the {fmtInt(st.total)} families in the Google Fonts library, {fmtInt(matched)} sit in an open-licence folder: {fmtInt(st.lic.ofl)} OFL, {fmtInt(st.lic.apache)} Apache 2.0 and {fmtInt(st.lic.ufl)} Ubuntu Font Licence. All allow commercial, web and logo use; OFL fonts just cannot be sold on their own.
    </p>
  </section>

  <form class="desk" id="desk" role="search" aria-label="Filter fonts" onsubmit="return false">
    <div class="f-q"><label for="q">Family or designer</label><input id="q" type="search" autocomplete="off" placeholder="e.g. Inter, Noto Sans, Rasmus Andersson" /></div>
    <div><label for="cat">Category</label>
      <select id="cat"><option value="">All categories</option>{CATEGORIES.map((c) => <option value={c}>{c}</option>)}</select></div>
    <div><label for="script">Script / subset</label>
      <select id="script"><option value="">Any</option>{SCRIPTS.map(([v, l]) => <option value={v}>{l}</option>)}</select></div>
    <div><label for="lic">Licence</label>
      <select id="lic"><option value="">Any</option><option value="ofl">OFL 1.1</option><option value="apache">Apache 2.0</option><option value="ufl">Ubuntu Font Licence</option></select></div>
    <div><label for="minw">Weights</label>
      <select id="minw"><option value="0">Any</option><option value="3">3 or more</option><option value="5">5 or more</option><option value="9">Full range (9)</option></select></div>
    <div><label for="sort">Order</label>
      <select id="sort"><option value="pop">Most used</option><option value="trend">Trending</option><option value="new">Newest</option><option value="name">A–Z</option></select></div>
    <div class="f-chk">
      <label class="check"><input id="vf" type="checkbox" /> Variable only</label>
      <label class="check"><input id="it" type="checkbox" /> Has italics</label>
    </div>
    <div class="f-sample"><label for="sample">Proof text</label><input id="sample" type="text" maxlength="60" placeholder="Type your own words to proof" /></div>
    <div class="f-size"><label for="size">Size <output id="sizeOut" for="size">40</output>px</label><input id="size" type="range" min="18" max="96" value="40" /></div>
  </form>

  <div class="desk-status mono" aria-live="polite">
    <p id="count">Showing the {INITIAL} most-used families. Filters load the full index of {fmtInt(st.total)}.</p>
    <p id="state" class="small"></p>
  </div>

  <ol class="rows" id="rows">
    {families.slice(0, INITIAL).map((f, i) => <FontRow f={f} rank={i + 1} />)}
  </ol>
  <p class="more"><button type="button" id="more" class="ghost" hidden>Show 48 more</button></p>
  <noscript><p class="note">The filters need JavaScript. Without it you see the {INITIAL} most-used families; the <a href="/fonts/">font index</a> lists every family with its own page.</p></noscript>

  <section class="prose-wide">
    <h2>What the {fmtInt(st.total)} families are made of</h2>
    <p>Counted from Google’s family metadata and the licence folder each family sits in on <a href={fontsData.licenseSourceUrl}>github.com/google/fonts</a> (snapshot {asOfHuman}). Six families could not be matched to a folder by name; we show them as “licence unmatched” instead of guessing.</p>
    <div class="tbl-wrap">
      <table>
        <caption>Families by category and licence, {asOfHuman}</caption>
        <thead><tr><th scope="col">Category</th><th class="num" scope="col">Families</th><th class="num" scope="col">OFL 1.1</th><th class="num" scope="col">Apache 2.0</th><th class="num" scope="col">UFL 1.0</th><th class="num" scope="col">Variable</th></tr></thead>
        <tbody>
          {catRows.map((r) => <tr><th scope="row">{r.c}</th><td class="num">{fmtInt(r.n)}</td><td class="num">{fmtInt(r.ofl)}</td><td class="num">{fmtInt(r.apache)}</td><td class="num">{fmtInt(r.ufl)}</td><td class="num">{fmtInt(r.vf)}</td></tr>)}
          <tr class="total"><th scope="row">All</th><td class="num">{fmtInt(st.total)}</td><td class="num">{fmtInt(st.lic.ofl)}</td><td class="num">{fmtInt(st.lic.apache)}</td><td class="num">{fmtInt(st.lic.ufl)}</td><td class="num">{fmtInt(st.variable)}</td></tr>
        </tbody>
      </table>
    </div>
    <p>{fmtInt(st.variable)} families ({Math.round((st.variable / st.total) * 100)}%) ship as variable fonts, and {fmtInt(st.cjk)} cover at least one Chinese, Japanese or Korean subset ({fmtInt(st.korean)} include Korean). Use the desk above to narrow by any of these.</p>

    <h2>Where to go from the desk</h2>
    <ul class="desk-links">
      <li><a href="/tools/license-checker/">Licence checker</a> — pick a family and a use (logo, app, merch, resale) and get the verdict with the clause it rests on.</li>
      <li><a href="/tools/pairing/">Pairing tester</a> — set a heading and body face side by side, with pairings computed from metadata.</li>
      <li><a href="/tools/type-scale/">Type-scale generator</a> — modular scale plus fluid <code>clamp()</code> values.</li>
      <li><a href="/guides/can-i-use-google-fonts-commercially/">Can I use Google Fonts commercially?</a> and <a href="/guides/">nine more guides</a> on licensing, variable fonts and CJK subsetting.</li>
    </ul>
  </section>
</Base>

<script>
  import { initDesk } from '../scripts/desk';
  initDesk();
</script>

<style>
  .desk-head { max-width: 62rem; }
  .desk {
    display: grid; gap: 0.8rem 1rem; grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 2px solid var(--ink); border-bottom: 1px solid var(--ink); padding: 1rem 0; margin-top: 1.6rem;
  }
  .desk > div { min-width: 0; }
  .f-q, .f-sample, .f-chk { grid-column: 1 / -1; }
  .f-chk { display: flex; flex-wrap: wrap; gap: 0 1.4rem; }
  @media (min-width: 900px) {
    .desk { grid-template-columns: 2.2fr repeat(5, minmax(0, 1fr)); align-items: end; }
    .f-q { grid-column: 1 / 2; }
    .f-sample { grid-column: 1 / 4; }
    .f-size { grid-column: 4 / 6; }
    .f-chk { grid-column: 6 / 7; flex-direction: column; gap: 0; }
  }
  .desk-status { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0 1rem; font-size: 0.8rem; color: var(--ink-2); padding: 0.5rem 0; min-height: 2.6rem; }
  .desk-status p { margin: 0; }
  .rows { list-style: none; margin: 0; padding: 0; --spec: 40px; }
  :global(.row) { display: grid; grid-template-columns: 3.2rem minmax(0, 1fr); gap: 0 0.8rem; border-bottom: 1px solid var(--hair); padding: 0.55rem 0 0.45rem; }
  :global(.row-no) { font-size: 0.72rem; color: var(--proof); padding-top: 0.5rem; }
  :global(.spec) {
    margin: 0; font-size: var(--spec); line-height: 1.3; height: calc(var(--spec) * 1.3); overflow: hidden;
    white-space: nowrap; text-overflow: ellipsis; color: var(--ink); font-synthesis: none;
  }
  :global(.spec.pending) { color: var(--ink-2); }
  :global(.row-meta) { margin: 0.2rem 0 0; display: flex; flex-wrap: wrap; gap: 0 0.9rem; font-size: 0.74rem; color: var(--ink-2); align-items: center; }
  :global(.row-name) { font-size: 0.86rem; color: var(--ink); font-weight: 500; display: inline-flex; align-items: center; min-height: 36px; }
  :global(.lic) { text-transform: uppercase; color: var(--ok); }
  :global(.lic-unknown) { color: var(--proof); }
  @media (max-width: 520px) { :global(.row) { grid-template-columns: 2.4rem minmax(0, 1fr); } }
  .more { text-align: center; margin: 1.2rem 0; }
  .prose-wide { max-width: 62rem; }
  .desk-links li { margin-bottom: 0.5rem; }
  tr.total th, tr.total td { border-top: 2px solid var(--ink); font-weight: 650; }
</style>
