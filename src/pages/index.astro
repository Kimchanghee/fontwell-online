---
import { readFile } from 'fs/promises';
import { join } from 'path';

interface FontMeta {
  family: string;
  category: string;
  variants: string[];
  subsets: string[];
  source: 'google' | 'noonnu';
  designer?: string;
  license: string;
  previewUrl: string;
}

let fonts: FontMeta[] = [];
try {
  const data = await readFile(join(process.cwd(), 'src/data/fonts.json'), 'utf-8');
  fonts = JSON.parse(data);
} catch {}

const koreanFonts = fonts.filter((f) => f.subsets.includes('korean'));
const popular = fonts.filter((f) => f.source === 'google').slice(0, 24);

const baseUrl = import.meta.env.PUBLIC_SITE_URL || 'https://fontwell.online';
const popunderKey = import.meta.env.PUBLIC_ADSTERRA_POPUNDER_KEY;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>FontWell — 무료 폰트·아이콘·템플릿 검색</title>
    <meta name="description" content="Google Fonts 1700+, 한글 무료폰트, Iconify, 무료 템플릿을 한 곳에서 검색하고 미리보기. 라이선스·다운로드·미리보기 통합." />
    <link rel="canonical" href={baseUrl} />
  </head>
  <body class="bg-slate-50 text-slate-900 antialiased">
    <header class="border-b bg-white">
      <div class="container mx-auto flex max-w-6xl items-center justify-between p-4">
        <a href="/" class="text-2xl font-bold text-purple-600">FontWell</a>
        <nav class="flex gap-3 text-sm">
          <a href="/category/sans-serif" class="hover:text-purple-600">Sans</a>
          <a href="/category/serif" class="hover:text-purple-600">Serif</a>
          <a href="/category/display" class="hover:text-purple-600">Display</a>
          <a href="/category/korean" class="hover:text-purple-600">한글</a>
        </nav>
      </div>
    </header>

    <section class="bg-gradient-to-br from-purple-50 to-white py-12">
      <div class="container mx-auto max-w-6xl px-4 text-center">
        <h1 class="text-4xl md:text-5xl font-bold tracking-tight">디자이너의 폰트·템플릿 위키</h1>
        <p class="mt-3 text-slate-600">{fonts.length}개 폰트 + 한글 무료폰트 + 무료 아이콘 + 템플릿. 모두 무료.</p>
      </div>
    </section>

    {koreanFonts.length > 0 && (
      <section class="container mx-auto max-w-6xl px-4 py-8">
        <h2 class="mb-4 text-2xl font-semibold">한글 무료폰트</h2>
        <div class="grid grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-3">
          {koreanFonts.slice(0, 9).map((f) => (
            <a
              href={`/font/${encodeURIComponent(f.family.toLowerCase().replace(/\s+/g, '-'))}`}
              class="rounded-xl border bg-white p-5 transition hover:border-purple-400 hover:shadow"
            >
              <h3 class="text-lg font-semibold">{f.family}</h3>
              {f.designer && <p class="text-xs text-slate-500">{f.designer}</p>}
              <p class="mt-2 text-sm text-slate-600">한글 다양성을 즐기는 가장 빠른 길</p>
              <p class="mt-2 text-xs text-purple-600">{f.license}</p>
            </a>
          ))}
        </div>
      </section>
    )}

    {popular.length > 0 && (
      <section class="container mx-auto max-w-6xl px-4 py-8">
        <h2 class="mb-4 text-2xl font-semibold">인기 영문 폰트</h2>
        <div class="grid grid-cols-2 gap-3 md:grid-cols-4">
          {popular.map((f) => (
            <a
              href={`/font/${encodeURIComponent(f.family.toLowerCase().replace(/\s+/g, '-'))}`}
              class="rounded-lg border bg-white p-3 hover:border-purple-400"
            >
              <span class="font-semibold">{f.family}</span>
              <span class="ml-2 text-xs capitalize text-slate-500">{f.category}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    {popunderKey && (
      <script is:inline async type="text/javascript" src={`//pl${popunderKey}.profitableratecpm.com/${popunderKey}/invoke.js`} />
    )}
  </body>
</html>
