---
import { readFile } from 'fs/promises';
import { join } from 'path';

export function getStaticPaths() {
  const categories = ['sans-serif', 'serif', 'display', 'handwriting', 'monospace', 'korean'];
  return categories.map((category) => ({ params: { category } }));
}

const { category } = Astro.params;
const baseUrl = import.meta.env.PUBLIC_SITE_URL || 'https://fontwell.online';
let fonts: any[] = [];
try {
  const data = await readFile(join(process.cwd(), 'src/data/fonts.json'), 'utf-8');
  fonts = JSON.parse(data);
} catch {}
const filtered = fonts.filter((font) => font.category === category);
const title = `${category} fonts | FontWell`;
const categoryNotes: Record<string, string> = {
  'sans-serif': 'Sans-serif families are usually the safest choice for dashboards, SaaS screens, mobile apps, and long interface labels because they stay readable at small sizes.',
  serif: 'Serif families work well for editorial pages, essays, reports, and brand moments where a little more rhythm and authority helps the text feel intentional.',
  display: 'Display fonts should be used for short headlines, campaign titles, thumbnails, and posters. Avoid using them for dense body copy or small buttons.',
  handwriting: 'Handwriting fonts add personality to invitations, creator thumbnails, quote cards, and casual brand accents, but they need extra spacing to stay legible.',
  monospace: 'Monospace fonts are best for code, tables, technical notes, terminal-style UI, and any layout where every character needs predictable width.',
  korean: 'Korean fonts need careful previewing because Hangul density, Latin fallback, number shape, and weight availability can change the feel of an entire page.'
};
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={`Browse ${category} fonts with previews, licenses and download links.`} />
    <link rel="canonical" href={`${baseUrl}/category/${category}`} />
    <meta property="og:title" content={title} />
    <meta property="og:url" content={`${baseUrl}/category/${category}`} />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HHPMVVCTOD"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-HHPMVVCTOD', { page_path: window.location.pathname });
    </script>
    <link rel="stylesheet" href="/global.css" />
    <script is:inline>
  window.addEventListener('click', function(event) {
    var link = event.target && event.target.closest ? event.target.closest('a[rel*="sponsored"], [data-affiliate-link]') : null;
    if (!link || typeof window.gtag !== 'function') return;
    window.gtag('event', 'affiliate_click', {
      merchant: (link.textContent || '').trim().slice(0, 60) || 'partner',
      placement: link.getAttribute('data-placement') || link.getAttribute('aria-label') || 'sponsored-link',
      page_location: window.location.href
    });
  }, { capture: true });
</script>
</head>
  <body class="bg-slate-50 text-slate-900">
    <header class="border-b bg-white">
      <div class="mx-auto flex max-w-6xl items-center justify-between p-4">
        <a href="/" class="text-2xl font-bold text-purple-600">FontWell</a>
        <a href="/" class="text-sm hover:text-purple-600">All fonts</a>
      </div>
    </header>
    <main class="mx-auto max-w-6xl px-4 py-10">
      <h1 class="text-4xl font-bold capitalize">{category} fonts</h1>
      <p class="mt-3 text-slate-600">Preview popular {category} font families and open the official source.</p>
      <section class="mt-6 rounded-xl border bg-white p-6">
        <h2 class="text-xl font-semibold">Choosing a {category} font</h2>
        <p class="mt-3 leading-7 text-slate-700">{categoryNotes[category]}</p>
        <p class="mt-3 leading-7 text-slate-700">
          Start with the job the font needs to do: navigation labels need clarity, article pages need calm rhythm,
          marketing headers need a recognizable voice, and data-heavy tools need numbers that line up cleanly.
          Preview the same sentence across several families before opening a download source so the decision is based
          on reading quality, not only on the first attractive specimen.
        </p>
        <div class="mt-5 grid gap-3 md:grid-cols-3">
          <div class="rounded-lg bg-purple-50 p-4 text-sm leading-6">Preview Korean, English, numbers, and symbols before using a family in production.</div>
          <div class="rounded-lg bg-purple-50 p-4 text-sm leading-6">Check license terms on the official source, especially for commercial templates or client work.</div>
          <div class="rounded-lg bg-purple-50 p-4 text-sm leading-6">Compare at least two weights so headings and body text do not collapse into one visual tone.</div>
        </div>
      </section>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {filtered.map((font) => (
          <a href={`/font/${encodeURIComponent(font.family.toLowerCase().replace(/\s+/g, '-'))}`} class="rounded-xl border bg-white p-5 hover:border-purple-400">
            <div class="text-xl font-semibold">{font.family}</div>
            <div class="mt-2 text-sm text-slate-500">{font.license || 'Open license'} · {font.source}</div>
          </a>
        ))}
      </div>
    </main>
  </body>
</html>
