---
import Base from '../layouts/Base.astro';
import { fitTitle, fitDesc, abs } from '../lib/seo';
import { site } from '../site.config';

const title = fitTitle(['Contact Fontwell: corrections, questions and feedback', 'Contact Fontwell about corrections, licences or data']);
const description = fitDesc([
  'How to reach Fontwell: report a wrong licence verdict or date, suggest a question for a guide, or ask about advertising. One email address, read by the people who fix things.',
  'How to reach Fontwell: report a wrong licence verdict or date, suggest a question for a new guide, or ask about advertising. One email address, read by the people who fix it.',
]);
const crumbs = [{ name: 'Desk', path: '/' }, { name: 'Contact', path: '/contact/' }];
const ld = [{ '@type': 'ContactPage', name: 'Contact Fontwell', url: abs('/contact/'), mainEntity: { '@id': `${site.url}/#organization` } }];
---
<Base title={title} description={description} path="/contact/" og="/og/about.png" ld={ld} crumbs={crumbs}>
  <article class="prose">
    <p class="kicker">Contact</p>
    <h1>How do I contact Fontwell?</h1>
    <p class="lede" data-answer>Email <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>. It is the single address for corrections, questions about the data, guide suggestions and advertising enquiries.</p>
    <h2>Reporting an error</h2>
    <p>Please include the page address, what is wrong and, if you can, a link to the source that shows the correct information (for example the family’s licence file on GitHub). Licence verdicts and figures are corrected in the next build; see the <a href="/methodology/">methodology</a> for how data is refreshed.</p>
    <h2>What we cannot do</h2>
    <p>We cannot give legal advice about your specific project, grant permissions on behalf of font authors, or change the licence of a font. For permission questions (for example using a Reserved Font Name), contact the copyright holder named in the font’s licence. The <a href="/guides/">guides</a> may already answer common questions.</p>
    <h2>Privacy</h2>
    <p>Emails are used only to answer you and are not added to any mailing list. See the <a href="/privacy/">privacy policy</a>.</p>
  </article>
</Base>
