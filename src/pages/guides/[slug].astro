---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import { abs, faqLd } from '../../lib/seo';
import { fmtDate } from '../../lib/data';
import { site } from '../../site.config';

export async function getStaticPaths() {
  const all = await getCollection('guides');
  return all.map((g) => ({ params: { slug: g.id }, props: { g, all } }));
}
const { g, all } = Astro.props;
const { Content } = await render(g);
const d = g.data;
const related = d.related.map((id: string) => all.find((x: any) => x.id === id)).filter(Boolean);
const crumbs = [{ name: 'Desk', path: '/' }, { name: 'Guides', path: '/guides/' }, { name: d.question, path: `/guides/${g.id}/` }];
const ld = [
  {
    '@type': 'TechArticle',
    headline: d.question,
    description: d.description,
    url: abs(`/guides/${g.id}/`),
    datePublished: d.published.toISOString(),
    dateModified: d.updated.toISOString(),
    author: { '@id': `${site.url}/#organization` },
    publisher: { '@id': `${site.url}/#organization` },
    image: abs(`/og/guides/${g.id}.png`),
    citation: d.sources.map((s: { url: string }) => s.url),
    mainEntityOfPage: abs(`/guides/${g.id}/`),
  },
  ...(d.faq.length ? [faqLd(d.faq)] : []),
];
---
<Base title={d.title} description={d.description} path={`/guides/${g.id}/`} og={`/og/guides/${g.id}.png`} ogType="article" ld={ld} crumbs={crumbs}>
  <article class="guide">
    <div class="kicker">Guide · updated <time datetime={d.updated.toISOString().slice(0, 10)}>{fmtDate(d.updated.toISOString())}</time></div>
    <h1>{d.question}</h1>
    <div class="split">
      <div class="prose">
        <p class="lede" data-answer>{d.answer}</p>
        <Content />
        <Faq items={d.faq} />
        <h2>Sources</h2>
        <ol class="sources">
          {d.sources.map((s: { title: string; url: string }) => <li><a href={s.url}>{s.title}</a></li>)}
        </ol>
        <p class="note small">Facts checked against the sources above as of {d.data_asof}. Licence explanations are general information, not legal advice; read the licence shipped with the font you use. Spotted an error? <a href="/contact/">Tell us</a>.</p>
      </div>
      <aside class="margin-note sticky" aria-label="About this guide">
        <dl>
          <dt>Published</dt><dd>{fmtDate(d.published.toISOString())}</dd>
          <dt>Updated</dt><dd>{fmtDate(d.updated.toISOString())}</dd>
          <dt>Checked</dt><dd>{d.data_asof}</dd>
          <dt>Sources</dt><dd>{d.sources.length}</dd>
        </dl>
        {related.length > 0 && (
          <>
            <p class="rel-h">Read next</p>
            <ul class="rel">
              {related.map((r: any) => <li><a href={`/guides/${r.id}/`}>{r.data.question}</a></li>)}
            </ul>
          </>
        )}
      </aside>
    </div>
  </article>
</Base>

<style>
  .guide h1 { max-width: 28ch; }
  .guide :global(.prose h2) { font-size: var(--s2); }
  .guide :global(.prose table) { margin: 1rem 0 1.4rem; }
  .rel-h { margin: 1.2rem 0 0.3rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--proof); }
  .rel { list-style: none; padding: 0; margin: 0; font-family: var(--serif); font-size: 0.95rem; }
  .rel li { border-top: 1px solid var(--hair); }
  .rel a { display: block; padding: 0.5rem 0; }
</style>
